{
  "name": "itmosoft/laravel-vendor-products",
  "description": "Associate marketplace vendors with polymorphic product models and manage vendor product assignments.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/support": "^12.0 || ^13.0",
    "illuminate/database": "^12.0 || ^13.0",
    "itmosoft/laravel-vendors": "^1.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0 || ^11.0",
    "phpunit/phpunit": "^11.0 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "ItmoSoft\\VendorProducts\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ItmoSoft\\VendorProducts\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ItmoSoft\\VendorProducts\\VendorProductsServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}